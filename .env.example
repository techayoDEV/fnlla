# ==============================================================================
# FNLLA ENVIRONMENT TEMPLATE
# Copyright (c) 2026 TechAyo LTD (techayo.co.uk). All rights reserved.
# Produced, maintained and distributed by TechAyo LTD.
# This template defines the baseline local environment contract for FNLLA.
# FNLLA uses MySQL and the vendored FNLLA Runtime runtime in the official stack.
# ==============================================================================

APP_ENV=development
APP_DEBUG=true
APP_URL=
APP_TIMEZONE=UTC
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_LOG_PATH=

FNLLA_RUNTIME_ENFORCE=true
FNLLA_RUNTIME_AUTO_SYNC=true
FNLLA_RUNTIME_SYNC_INTERVAL_SECONDS=900
FNLLA_RUNTIME_SYNC_SCRIPT=scripts/sync-fnlla-runtime.ps1
FNLLA_RUNTIME_STATE_PATH=framework/fnlla-runtime-guard.json
PROCESS_TIMEOUT_SECONDS=300
PROCESS_OUTPUT_LIMIT_BYTES=1048576
CACHE_SERIALIZER=json
HEALTH_CACHE_TTL_SECONDS=10
OBSERVABILITY_ACCESS_LOG_ENABLED=true
OBSERVABILITY_RESPONSE_TIME_HEADER_ENABLED=true
OBSERVABILITY_RESPONSE_TIME_HEADER=X-Response-Time
OBSERVABILITY_METRICS_ENABLED=true
OBSERVABILITY_METRICS_PATH=framework/metrics.json
REQUEST_MAX_BODY_BYTES=1048576
UPLOAD_MAX_FILE_BYTES=5242880
UPLOAD_ALLOWED_MIME_TYPES=image/jpeg,image/png,image/webp,application/pdf,text/plain
LOG_REDACT_KEYS=password,pass,secret,token,authorization,cookie,set-cookie,csrf,_token,api_key
LOG_MAX_FILE_BYTES=5242880
LOG_MAX_ROTATED_FILES=5

FRAMEWORK_UPDATE_UI_ENABLED=true
FRAMEWORK_UPDATE_UI_LOCAL_ONLY=true
FRAMEWORK_UPDATE_UI_APPLY_ENABLED=true
FRAMEWORK_UPDATE_GITHUB_ENABLED=true
FRAMEWORK_UPDATE_GITHUB_REPOSITORY=techayoDEV/fnlla
FRAMEWORK_UPDATE_GITHUB_API_BASE_URL=https://api.github.com
FRAMEWORK_UPDATE_GITHUB_TIMEOUT_SECONDS=20
FRAMEWORK_UPDATE_DOWNLOAD_CACHE_PATH=framework/updates/fnlla
FRAMEWORK_UPDATE_SOURCE_PATH=
FRAMEWORK_UPDATE_POST_INSTALL_CHECKS=true
TRUSTED_PROXIES=
TRUSTED_HOSTS=

MAINTENANCE_MODE_ENABLED=false
MAINTENANCE_ACCESS_USERNAME=
MAINTENANCE_ACCESS_PASSWORD=
MAINTENANCE_SETUP_UI_ENABLED=true
MAINTENANCE_SETUP_UI_LOCAL_ONLY=true
MAINTENANCE_ACCESS_TTL_MINUTES=10
MAINTENANCE_ACCESS_MAX_ATTEMPTS=5
MAINTENANCE_ACCESS_WINDOW_MINUTES=15
MAINTENANCE_ACCESS_LOCKOUT_MINUTES=15

CLIENT_PREVIEW_ENABLED=false
CLIENT_PREVIEW_LOGIN_DISABLED=false
CLIENT_PREVIEW_KICKER=Private Client Preview
CLIENT_PREVIEW_TITLE=Your project is being restored
CLIENT_PREVIEW_LAST_UPDATED_LABEL=Last updated
CLIENT_PREVIEW_LAST_UPDATED_VALUE=
CLIENT_PREVIEW_SHOW_LAST_UPDATED=true
CLIENT_PREVIEW_STATUS_TITLE=Infrastructure operational, restoration in progress
CLIENT_PREVIEW_STATUS_BODY=Our new infrastructure is now fully operational, and we are synchronising your project and restoring access.
CLIENT_PREVIEW_COUNTDOWN_LABEL=Full Access Restoration in
CLIENT_PREVIEW_RESTORE_AT=
CLIENT_PREVIEW_STARTED_AT=
CLIENT_PREVIEW_PROGRESS_ENABLED=true
CLIENT_PREVIEW_PROGRESS_LABEL=Restoration progress
CLIENT_PREVIEW_MESSAGE=We sincerely apologise for the recent delay caused by our infrastructure migration and appreciate your patience while we complete the final restoration process.
CLIENT_PREVIEW_SUPPORT_HEADING=Need assistance?
CLIENT_PREVIEW_SUPPORT_EMAIL=
CLIENT_PREVIEW_UNLOCK_BUTTON_LABEL=Unlock preview
CLIENT_PREVIEW_LOCKED_NOTICE=Preview unlock is temporarily unavailable while the restoration is completed.

DEVELOPER_ACCESS_ENABLED=true
DEVELOPER_ACCESS_PATH=
DEVELOPER_ACCESS_PASSWORD=
DEVELOPER_ACCESS_SETUP_UI_ENABLED=true
DEVELOPER_ACCESS_SETUP_UI_LOCAL_ONLY=true
DEVELOPER_ACCESS_TTL_MINUTES=120
DEVELOPER_ACCESS_MAX_ATTEMPTS=5
DEVELOPER_ACCESS_WINDOW_MINUTES=15
DEVELOPER_ACCESS_LOCKOUT_MINUTES=15
DEVELOPER_OPERATIONS_NAV_MODE=hidden

SESSION_NAME=fnlla_session
SESSION_LIFETIME_MINUTES=120
SESSION_ROTATE_AFTER_MINUTES=30
SESSION_SECURE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=Lax
SESSION_STRICT_MODE=true
SESSION_USE_ONLY_COOKIES=true

CSRF_ROTATE_AFTER_MINUTES=120

DB_DATABASE=fnlla
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_PERSISTENT=false
DB_SSL_ENABLED=false
DB_SSL_CA=
DB_SSL_CERT=
DB_SSL_KEY=
DB_SSL_VERIFY_SERVER_CERT=true
DB_READ_HOST=
DB_READ_PORT=
DB_MIGRATIONS_TABLE=migrations

MAIL_MAILER=log
MAIL_LOG_PATH=mail
MAIL_NATIVE_ENABLED=false
MAIL_MAX_RECIPIENTS=10
MAIL_FROM_ADDRESS=no-reply@example.com
MAIL_FROM_NAME=FNLLA
MAIL_REPLY_TO_ADDRESS=
MAIL_HTTP_ENDPOINT=
MAIL_HTTP_TOKEN=
MAIL_HTTP_TIMEOUT_SECONDS=10
MAIL_HTTP_REQUIRE_HTTPS=true
MAIL_HTTP_ALLOWED_HOSTS=
CONTACT_NOTIFICATION_EMAIL=team@example.com

AI_RUNTIME_ENABLED=false
AI_RUNTIME_DRIVER=local
AI_RUNTIME_PATH=resources/fnlla-ai-runtime
AI_RUNTIME_LOAD_INTEGRATED=true
AI_RUNTIME_LEARNING_ENABLED=false
AI_RUNTIME_LEARNING_PATH=framework/ai/runtime-knowledge.json
AI_RUNTIME_MAX_INPUT_CHARS=2000
AI_RUNTIME_CONFIDENCE_THRESHOLD=35
AI_RUNTIME_NAME="FNLLA Assistant"
AI_RUNTIME_DIRECTION="Answer from the configured local project knowledge only."
AI_RUNTIME_FALLBACK="I do not know that from the local project knowledge yet."

QUEUE_PATH=framework/queue

AUTH_SESSION_KEY=auth.user_id
AUTH_USERS_TABLE=users
AUTH_USERS_KEY=id
AUTH_USERS_IDENTITY=email
AUTH_USERS_PASSWORD=password
