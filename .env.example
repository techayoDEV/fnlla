# ==============================================================================
# FNLLA ENVIRONMENT STARTER
# Version: 2.2.2
# Copyright (c) 2026 TechAyo LTD (techayo.co.uk). Released under the MIT License.
#
# This file is the short project-start template. For the full environment
# contract, see .env.full.example and docs/ENVIRONMENT.md.
# ==============================================================================

APP_ENV=development
APP_DEBUG=true
APP_NAME=FNLLA
APP_TAGLINE=
APP_BRAND_LOGO=auto
# Leave APP_URL empty for auto-detected local URLs; set it explicitly for staging or production.
APP_URL=
ASSET_URL=
APP_TIMEZONE=UTC
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_LOG_PATH=

# Official FNLLA framework identity. Downstream projects keep these as framework
# metadata; APP_NAME and APP_URL remain the project-specific public identity.
FNLLA_OFFICIAL_DOMAIN=fnlla.com
FNLLA_OFFICIAL_URL=https://fnlla.com
FNLLA_SUPPORT_EMAIL=support@fnlla.com
FNLLA_MAIL_FROM_ADDRESS=noreply@fnlla.com
FNLLA_MAINTAINER_URL=https://techayo.co.uk

# Project identity. project:claim fills these values in exported projects.
PROJECT_ID=FNLLA_PROJECT
PROJECT_NAME="FNLLA Project"
PROJECT_OWNER="Owner"
PROJECT_FUNDER=
PROJECT_CLIENT=
PROJECT_SYSTEM_OWNER="Owner"
PROJECT_DEVELOPER="Developer"
PROJECT_MAINTAINER="Developer"
PROJECT_RUNTIME="FNLLA"
PROJECT_RUNTIME_CREATOR="TechAyo LTD (techayo.co.uk)"

# Optional responsibility record. Public display requires confirmed status.
PROJECT_LEADERSHIP_ORGANIZATION=
PROJECT_LEADERSHIP_PERSON_NAME=
PROJECT_LEADERSHIP_PERSON_EMAIL=
PROJECT_LEADERSHIP_PERSON_ROLE=
PROJECT_LEADERSHIP_RESPONSIBILITY=
PROJECT_LEADERSHIP_PROFILE_URL=
PROJECT_LEADERSHIP_VISIBILITY=disabled
PROJECT_LEADERSHIP_STATUS=pending
PROJECT_LEADERSHIP_CONFIRMED_BY=
PROJECT_LEADERSHIP_CONFIRMED_AT=

# Public client-preview / maintenance mode.
MAINTENANCE_MODE_ENABLED=false
MAINTENANCE_ACCESS_USERNAME=
MAINTENANCE_ACCESS_PASSWORD=
MAINTENANCE_SETUP_UI_ENABLED=true
MAINTENANCE_SETUP_UI_LOCAL_ONLY=true
CLIENT_PREVIEW_ENABLED=false
CLIENT_PREVIEW_LOGIN_DISABLED=false
CLIENT_PREVIEW_TITLE=Private client preview is active
CLIENT_PREVIEW_STATUS_TITLE=Password-protected preview mode is enabled
CLIENT_PREVIEW_STATUS_BODY=This project is online for client review, but public access is locked until the preview password is entered.
CLIENT_PREVIEW_MESSAGE=Use the client preview password supplied by the project team to review the current build before public launch.

# Private Developer Panel access. Use named accounts; password-only access is not supported.
DEVELOPER_ACCESS_ENABLED=true
DEVELOPER_ACCESS_PATH=/developer
DEVELOPER_ACCESS_EMAIL=
DEVELOPER_ACCESS_USERS=
DEVELOPER_ACCESS_RECOVERY_ENABLED=true
DEVELOPER_ACCESS_RECOVERY_TTL_MINUTES=30
DEVELOPER_ACCESS_SETUP_UI_ENABLED=true
DEVELOPER_ACCESS_SETUP_UI_LOCAL_ONLY=true
DEVELOPER_ACCESS_TOTP_ISSUER="${APP_NAME}"
DEVELOPER_OPERATIONS_NAV_MODE=hidden

# Private Customer Portal access. Lead developers create invitations from Access & Security.
CUSTOMER_ACCESS_ENABLED=true
CUSTOMER_ACCESS_PATH=/client
CUSTOMER_ACCESS_USERS=
CUSTOMER_ACCESS_INVITE_TTL_HOURS=72
CUSTOMER_ACCESS_TTL_MINUTES=240
CUSTOMER_ACCESS_ABSOLUTE_TTL_MINUTES=720
CUSTOMER_ACCESS_MAX_ATTEMPTS=5
CUSTOMER_ACCESS_WINDOW_MINUTES=15
CUSTOMER_ACCESS_LOCKOUT_MINUTES=15

# Developer service-control contract.
FNLLA_POLICY_PROFILE=standard
FNLLA_REGULATED_MODE=false
DEVELOPER_CONTROL_DISABLED_CONTACT=developer@example.com
DEVELOPER_CONTROL_SERVICE_PROVIDER=TechAyo Limited
DEVELOPER_CONTROL_SUSPENDED_TITLE=Services suspended
DEVELOPER_CONTROL_SUSPENDED_MESSAGE=Your services have been suspended. Please contact your service provider.
DEVELOPER_ACTIVITY_LOG_DRIVER=file
DEVELOPER_WORKSPACE_DRIVER=file
DEVELOPER_PRIVATE_TODO_PATH=framework/developer/private-todos.json
DEVELOPER_CONTROL_REMOTE_ENABLED=false
DEVELOPER_CONTROL_REMOTE_ENDPOINT=
DEVELOPER_CONTROL_REMOTE_TOKEN=
DEVELOPER_CONTROL_REMOTE_PROJECT_ID="${PROJECT_ID}"
DEVELOPER_CONTROL_REMOTE_TENANT=techayo
DEVELOPER_CONTROL_REMOTE_SIGNATURE_SECRET=

# Local first-party observability for the Developer Panel.
OBSERVABILITY_METRICS_ENABLED=true
OBSERVABILITY_ANALYTICS_ENABLED=true
OBSERVABILITY_ANALYTICS_RETENTION_DAYS=90
OBSERVABILITY_ANALYTICS_SAMPLE_RATE=100
OBSERVABILITY_ANALYTICS_BOT_FILTERING=true
OBSERVABILITY_ANALYTICS_DEVICE_DETECTION=true
OBSERVABILITY_ANALYTICS_TRACK_QUERY_STRINGS=false
OBSERVABILITY_HEATMAP_ENABLED=true
OBSERVABILITY_HEATMAP_SAMPLE_RATE=100
OBSERVABILITY_HEATMAP_GRID_COLUMNS=5
OBSERVABILITY_HEATMAP_GRID_ROWS=5
OBSERVABILITY_REGULATED_MAX_RETENTION_DAYS=30
OBSERVABILITY_REGULATED_EXCLUDED_PATHS=/developer,/maintenance,/client,/api
OBSERVABILITY_REGULATED_HEATMAP_ENABLED=false
OBSERVABILITY_SLOW_ROUTE_THRESHOLD_MS=750
DEBUG_TOOLBAR=false
DEBUG_REQUEST_HISTORY=false
DEBUG_RUNTIME_ISSUES=true

# Optional project-owned API hook adapter.
FNLLA_INTEGRATION_API_HOOKS_ENABLED=false
FNLLA_INTEGRATION_API_HOOKS_ENDPOINT=

# Security posture for local development. Harden these for production.
TRUSTED_PROXIES=
TRUSTED_HOSTS=
SECURITY_HEADERS_PRESET=balanced
STRICT_TRANSPORT_SECURITY=
REQUEST_MAX_BODY_BYTES=6291456
UPLOAD_MAX_FILE_BYTES=5242880
UPLOAD_ALLOWED_MIME_TYPES=image/jpeg,image/png,image/webp,application/pdf,text/plain,text/csv,application/zip,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document,application/vnd.ms-excel,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet
LOG_REDACT_KEYS=password,pass,secret,token,authorization,cookie,set-cookie,csrf,_token,api_key

# Session, database and mail defaults.
SESSION_NAME=fnlla_session
SESSION_DRIVER=file
SESSION_SECURE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=Lax
DB_DATABASE=fnlla
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=
MAIL_MAILER=log
MAIL_FROM_ADDRESS=noreply@fnlla.com
MAIL_FROM_NAME=FNLLA
CONTACT_NOTIFICATION_EMAIL=support@fnlla.com

# Runtime AI. Local is deterministic and default; Fionn is an opt-in API bridge.
AI_RUNTIME_ENABLED=true
AI_RUNTIME_DRIVER=local
AI_RUNTIME_PATH=resources/fnlla-ai-runtime
AI_RUNTIME_LEARNING_ENABLED=false
AI_FIONN_BRIDGE_ENABLED=false
AI_FIONN_ENDPOINT=
AI_FIONN_CHAT_PATH=/api/chat
AI_FIONN_API_TOKEN=
AI_FIONN_ALLOWED_HOSTS=127.0.0.1,localhost
AI_FIONN_ALLOW_INSECURE_LOCALHOST=true

# Queue and framework-update basics.
QUEUE_CONNECTION=file
QUEUE_PATH=framework/queue
FRAMEWORK_UPDATE_UI_ENABLED=true
FRAMEWORK_UPDATE_UI_LOCAL_ONLY=true
FRAMEWORK_UPDATE_UI_APPLY_ENABLED=true
FRAMEWORK_UPDATE_GITHUB_ENABLED=true
FRAMEWORK_UPDATE_APPLY_BACKUP_CONFIRMED=false
FRAMEWORK_UPDATE_APPLY_SIGNED_ARTIFACT_CONFIRMED=false
FRAMEWORK_UPDATE_APPLY_MAINTENANCE_WINDOW_CONFIRMED=false
FRAMEWORK_UPDATE_APPLY_CI_APPROVAL_CONFIRMED=false
