# ==============================================================================
# FNLLA ENVIRONMENT STARTER
# Version: 2.1.1
# Copyright (c) 2026 TechAyo LTD (techayo.co.uk). Released under the MIT License.
#
# This file is the short project-start template. For the full environment
# contract, see .env.full.example and docs/ENVIRONMENT.md.
# ==============================================================================

APP_ENV=development
APP_DEBUG=true
APP_URL=
ASSET_URL=
APP_TIMEZONE=UTC
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_LOG_PATH=

# Project identity. project:claim fills these values in exported projects.
PROJECT_ID=FNLLA_PROJECT
PROJECT_NAME="FNLLA Project"
PROJECT_OWNER="Owner LTD"
PROJECT_FUNDER=
PROJECT_CLIENT=
PROJECT_SYSTEM_OWNER="Owner LTD"
PROJECT_DEVELOPER="Developer LTD"
PROJECT_MAINTAINER="Developer LTD"
PROJECT_RUNTIME="FNLLA"
PROJECT_RUNTIME_CREATOR="TechAyo LTD (techayo.co.uk)"

# Public client-preview / maintenance mode.
MAINTENANCE_MODE_ENABLED=false
MAINTENANCE_ACCESS_USERNAME=
MAINTENANCE_ACCESS_PASSWORD=
MAINTENANCE_SETUP_UI_ENABLED=true
MAINTENANCE_SETUP_UI_LOCAL_ONLY=true
CLIENT_PREVIEW_ENABLED=false
CLIENT_PREVIEW_LOGIN_DISABLED=false
CLIENT_PREVIEW_TITLE=Private client preview is active
CLIENT_PREVIEW_STATUS_TITLE=Password-protected preview mode is enabled
CLIENT_PREVIEW_STATUS_BODY=This project is online for client review, but public access is locked until the preview password is entered.
CLIENT_PREVIEW_MESSAGE=Use the client preview password supplied by the project team to review the current build before public launch.

# Developer maintenance/update access.
DEVELOPER_ACCESS_ENABLED=true
DEVELOPER_ACCESS_PASSWORD=
DEVELOPER_ACCESS_PASSWORD_HASH=
DEVELOPER_ACCESS_SETUP_UI_ENABLED=true
DEVELOPER_ACCESS_SETUP_UI_LOCAL_ONLY=true
DEVELOPER_OPERATIONS_NAV_MODE=hidden

# Security posture for local development. Harden these for production.
TRUSTED_PROXIES=
TRUSTED_HOSTS=
SECURITY_HEADERS_PRESET=balanced
STRICT_TRANSPORT_SECURITY=
REQUEST_MAX_BODY_BYTES=1048576
UPLOAD_MAX_FILE_BYTES=5242880
UPLOAD_ALLOWED_MIME_TYPES=image/jpeg,image/png,image/webp,application/pdf,text/plain
LOG_REDACT_KEYS=password,pass,secret,token,authorization,cookie,set-cookie,csrf,_token,api_key

# Session, database and mail defaults.
SESSION_NAME=fnlla_session
SESSION_DRIVER=file
SESSION_SECURE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=Lax
DB_DATABASE=fnlla
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=
MAIL_MAILER=log
MAIL_FROM_ADDRESS=no-reply@example.com
MAIL_FROM_NAME=FNLLA
CONTACT_NOTIFICATION_EMAIL=team@example.com

# Runtime AI. Local is deterministic and default; Fionn is an opt-in API bridge.
AI_RUNTIME_ENABLED=true
AI_RUNTIME_DRIVER=local
AI_RUNTIME_PATH=resources/fnlla-ai-runtime
AI_RUNTIME_LEARNING_ENABLED=false
AI_FIONN_BRIDGE_ENABLED=false
AI_FIONN_ENDPOINT=
AI_FIONN_CHAT_PATH=/api/chat
AI_FIONN_API_TOKEN=
AI_FIONN_ALLOWED_HOSTS=127.0.0.1,localhost
AI_FIONN_ALLOW_INSECURE_LOCALHOST=true

# Queue and framework-update basics.
QUEUE_CONNECTION=file
QUEUE_PATH=framework/queue
FRAMEWORK_UPDATE_UI_ENABLED=true
FRAMEWORK_UPDATE_UI_LOCAL_ONLY=true
FRAMEWORK_UPDATE_UI_APPLY_ENABLED=true
FRAMEWORK_UPDATE_GITHUB_ENABLED=true
