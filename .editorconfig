root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true

[*.{md,json,xml,yml,yaml}]
indent_size = 2

[*.md]
# Two trailing spaces represent an intentional Markdown line break.
trim_trailing_whitespace = false

[*.{cmd,bat,ps1}]
end_of_line = crlf

[Makefile]
indent_style = tab
