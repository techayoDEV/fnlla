parameters:
    level: 5
    bootstrapFiles:
        - scripts/phpstan-bootstrap.php
    paths:
        - src
        - packages/fnlla-core/src
        - packages/fnlla-complete/src
    scanFiles:
        - packages/fnlla-core/src/Support/helpers.php
        - packages/fnlla-complete/src/Support/optional_helpers.php
    tmpDir: storage/framework/phpstan
