# FNLLA project configuration. Advanced reference: .env.full.example
APP_ENV=development
APP_DEBUG=true
APP_NAME=FNLLA
APP_URL=
ASSET_URL=
APP_TIMEZONE=UTC
APP_LOCALE=en

PROJECT_ID=FNLLA_PROJECT
PROJECT_NAME=FNLLA
PROJECT_OWNER="Owner"
PROJECT_DEVELOPER="Developer"

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

DEVELOPER_ACCESS_ENABLED=true
DEVELOPER_ACCESS_PATH=/developer
DEVELOPER_ACCESS_USERS=
# Recovery emails use MAIL_MAILER and the queue worker: php fnlla queue:work 50
DEVELOPER_ACCESS_RECOVERY_ENABLED=true
DEVELOPER_OPERATIONS_NAV_MODE=hidden
DEVELOPER_ACTIVITY_LOG_DRIVER=file
DEVELOPER_WORKSPACE_DRIVER=file
DEBUG_TOOLBAR=false
FNLLA_MODULE_WORKSPACE=true
FNLLA_MODULE_ANALYTICS=true
FNLLA_MODULE_HEATMAP=true
FNLLA_MODULE_CUSTOMER_PORTAL=true

MAINTENANCE_MODE_ENABLED=false
CLIENT_PREVIEW_ENABLED=false
MAIL_MAILER=log
MAIL_FROM_ADDRESS=no-reply@example.com
MAIL_FROM_NAME=FNLLA
