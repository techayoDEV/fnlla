{
  "schema": "fnlla.performance_baseline_policy.v1",
  "version": "2.1.0",
  "decision_gate": "perf:budget",
  "targets": [
    {
      "id": "cli.list",
      "probe": "php fnlla list",
      "max_regression_percent": 20,
      "max_regression_ms": 1000
    },
    {
      "id": "cli.route_list",
      "probe": "php fnlla route:list",
      "max_regression_percent": 20,
      "max_regression_ms": 1000
    },
    {
      "id": "http.home",
      "probe": "GET /",
      "max_regression_percent": 20,
      "max_regression_ms": 1000
    },
    {
      "id": "http.health",
      "probe": "GET /api/health",
      "max_regression_percent": 20,
      "max_regression_ms": 1000
    },
    {
      "id": "project.export",
      "probe": "php fnlla make:project",
      "max_regression_percent": 20,
      "max_regression_ms": 2000
    }
  ],
  "release_commands": [
    "php fnlla perf:baseline:update --iterations=7",
    "php fnlla perf:budget --iterations=5 --max-regression=20 --max-regression-ms=1000"
  ]
}
