DEVELOPER_CONTROL_REMOTE_ALLOWED_HOSTS=techayo.co.uk,www.techayo.co.uk

SESSION_NAME=fnlla_session
SESSION_DRIVER=file
SESSION_LIFETIME_MINUTES=120
SESSION_ABSOLUTE_LIFETIME_MINUTES=720
SESSION_ROTATE_AFTER_MINUTES=30
SESSION_SECURE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=Lax
SESSION_STRICT_MODE=true
SESSION_USE_ONLY_COOKIES=true

CSRF_ROTATE_AFTER_MINUTES=120

DB_DATABASE=fnlla
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=
