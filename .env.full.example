AI_RUNTIME_ENABLED=true
AI_RUNTIME_DRIVER=local
# Optional cloud text generation. Select a model available to your API account.
# Credentials remain server-side. Disabled adapters never send requests.
AI_OPENAI_ENABLED=false
AI_OPENAI_API_KEY=
AI_OPENAI_MODEL=
AI_OPENAI_MAX_OUTPUT_TOKENS=1024
AI_OPENAI_TIMEOUT_SECONDS=30
