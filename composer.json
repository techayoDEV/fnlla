{
    "name": "techayodev/fnlla",
    "description": "AI-ready web framework with a PHP foundation, integrated developer operations and opt-in AI providers.",
    "type": "project",
    "license": "MIT",
    "homepage": "https://fnlla.com",
    "authors": [
        {
            "name": "TechAyo LTD",
            "homepage": "https://techayo.co.uk",
            "role": "Producer, maintainer and distributor"
        },
        {
            "name": "Marcin Kordyaczny",
            "role": "Lead Developer / Product Manager"
        }
    ],
    "support": {
        "issues": "https://github.com/techayoDEV/fnlla/issues",
        "source": "https://github.com/techayoDEV/fnlla"
    },
    "require": {
        "php": "^8.3"
    },
    "suggest": {
        "ext-curl": "Required only for the optional OpenAI and Anthropic text-generation providers."
    },
    "require-dev": {
        "nyholm/psr7": "^1.8",
        "psr/http-server-handler": "^1.0",
        "psr/http-server-middleware": "^1.0",
        "symfony/mailer": "^7.4",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^12.5",
        "psr/container": "^2.0",
        "psr/log": "^3.0"
    },
    "autoload-dev": {
        "psr-4": {
            "Fnlla\\Smtp\\": "packages/fnlla-smtp/src/",
            "Fnlla\\Deploy\\": "packages/fnlla-deploy/src/",
            "Fnlla\\Psr\\": "packages/fnlla-psr/src/"
        }
    },
    "autoload": {
        "psr-4": {
            "Fnlla\\Php\\": "src/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "scripts": {
        "console": "@php fnlla",
        "test": "@php scripts/test.php",
        "test:unit": "@php vendor/phpunit/phpunit/phpunit",
        "analyse": "@php scripts/static-analysis.php",
        "doctor": "@php fnlla doctor",
        "ai:context": "@php fnlla ai:context",
        "ai:review-pack": "@php fnlla ai:review-pack",
        "app:map": "@php fnlla app:map",
        "perf": "@php fnlla perf:profile",
        "perf:baseline": "@php fnlla perf:baseline:update",
        "perf:budget": "@php fnlla perf:budget",
        "upgrade:check": "@php fnlla upgrade:check",
        "security": "@php fnlla security:audit",
        "release:prepare": "@php fnlla release:prepare",
        "lint": [
            "@php scripts/lint.php",
            "@php scripts/validate-fnlla-runtime.php",
            "@php scripts/validate-version-manifest.php"
        ]
    },
    "config": {
        "platform": {"php": "8.3.0"},
        "sort-packages": true
    }
}
