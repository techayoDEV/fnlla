{
    "name": "techayodev/fnlla",
    "description": "Open-source server-rendered PHP framework by TechAyo LTD. Public home of the FNLLA stack.",
    "type": "project",
    "license": "MIT",
    "homepage": "https://techayo.co.uk",
    "authors": [
        {
            "name": "TechAyo LTD",
            "homepage": "https://techayo.co.uk",
            "role": "Producer, maintainer and distributor"
        }
    ],
    "support": {
        "issues": "https://github.com/techayoDEV/fnlla/issues",
        "source": "https://github.com/techayoDEV/fnlla"
    },
    "require": {
        "php": "^8.3"
    },
    "autoload": {
        "psr-4": {
            "Fnlla\\Php\\": "src/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "scripts": {
        "console": "@php fnlla",
        "test": "@php scripts/test.php",
        "analyse": "@php scripts/static-analysis.php",
        "doctor": "@php fnlla doctor",
        "ai:context": "@php fnlla ai:context",
        "ai:review-pack": "@php fnlla ai:review-pack",
        "app:map": "@php fnlla app:map",
        "perf": "@php fnlla perf:profile",
        "perf:baseline": "@php fnlla perf:baseline:update",
        "perf:budget": "@php fnlla perf:budget",
        "upgrade:check": "@php fnlla upgrade:check",
        "security": "@php fnlla security:audit",
        "release:prepare": "@php fnlla release:prepare",
        "lint": [
            "@php scripts/lint.php",
            "@php scripts/validate-fnlla-runtime.php",
            "@php scripts/validate-version-manifest.php"
        ]
    },
    "config": {
        "sort-packages": true
    }
}
