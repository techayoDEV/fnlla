# Repository-wide line ending policy for FNLLA PHP and its vendored runtime assets.

* text=auto eol=lf

*.cmd text eol=crlf
*.bat text eol=crlf
*.ps1 text eol=crlf

*.php text eol=lf
*.json text eol=lf
*.md text eol=lf
*.css text eol=lf
*.js text eol=lf
*.svg text eol=lf
*.xml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.sh text eol=lf

*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary

# Editable brand masters stay in Git, not in framework source archives.
/branding/ export-ignore
.env export-ignore
.env.* export-ignore
.env.example -export-ignore
.env.full.example -export-ignore
/.fnlla/ export-ignore
/framework/ export-ignore
/dist/ export-ignore
/storage/ export-ignore
/vendor/ export-ignore
/node_modules/ export-ignore
/public/uploads/ export-ignore
/.idea/ export-ignore
/.vscode/ export-ignore
/backups/ export-ignore
/coverage/ export-ignore
/test-results/ export-ignore
/playwright-report/ export-ignore
auth.json export-ignore
.npmrc export-ignore
.pypirc export-ignore
id_rsa export-ignore
id_ed25519 export-ignore
.DS_Store export-ignore
Thumbs.db export-ignore
*.key export-ignore
*.pem export-ignore
*.p12 export-ignore
*.pfx export-ignore
*.sql export-ignore
*.sqlite export-ignore
*.sqlite3 export-ignore
*.bak export-ignore
*.log export-ignore
*.tmp export-ignore
*.zip export-ignore
