parameters:
    level: 5
    bootstrapFiles:
        - scripts/phpstan-bootstrap.php
    paths:
        - database
        - src
        - packages/fnlla-psr/src
        - packages/fnlla-smtp/src
        - packages/fnlla-deploy/src
    scanFiles:
        - src/Support/helpers.php
        - src/Support/optional_helpers.php
    tmpDir: storage/framework/phpstan
